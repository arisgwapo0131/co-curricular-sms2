# ============================================================
# Application Environment & Server Listening Configuration
# ============================================================
APP_NAME="Bestlink College of the Philippines"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://co-curricular.bcpsms2.com

# Server Listening Port & Host (Used by Docker, HostForge, and Web Servers)
PORT=80
APP_PORT=80
SERVER_PORT=80
HOST=0.0.0.0

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# ============================================================
# Logging Configuration
# ============================================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ============================================================
# Database Configuration & Deployment Profiles
# ============================================================
DB_CONNECTION=mysql

# --- Profile A: Local Development (XAMPP Default) ---
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=sms_db
# DB_USERNAME=root
# DB_PASSWORD=""

# --- Profile B: Railway Managed MySQL Service ---
# Use Railway variable references: ${{MySQL.MYSQLHOST}} or the internal DNS
DB_HOST=mysql.railway.internal
DB_PORT=3306
DB_DATABASE=railway
DB_USERNAME=root
DB_PASSWORD=""
# Optional Railway Combined URL:
# MYSQL_URL=mysql://root:password@mysql.railway.internal:3306/railway

# --- Profile C: Remote Cloud MySQL (TiDB / Aiven / PlanetScale / AWS RDS) ---
# DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_DATABASE=bcp_sms
# DB_USERNAME=your_username
# DB_PASSWORD="your_password"
# DB_SSL=true

# --- Profile D: Docker Compose Environment ---
# DB_HOST=db
# DB_PORT=3306
# DB_DATABASE=sms_db
# DB_USERNAME=sms_user
# DB_PASSWORD="sms_secure_password"

# Compatibility Aliases for Application Modules
DB_NAME=sms_db
DB_USER=root
DB_PASS=""
DB_SSL=false

# ============================================================
# Session & Cache Configuration
# ============================================================
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# ============================================================
# Email & OTP Transport (Resend API & Gmail SMTP Fallback)
# ============================================================
MAIL_MAILER=resend
RESEND_API_KEY=your_resend_api_key_here
MAIL_FROM_ADDRESS=onboarding@resend.dev
MAIL_FROM_NAME="BCP Co-Curricular Management System"

MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=cgales923@gmail.com
MAIL_PASSWORD="grmm zqtb worn wxie"
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=cgales923@gmail.com
MAIL_FROM_NAME="Bestlink College of the Philippines"

# ============================================================
# AI Engine Configuration (Google Gemini)
# ============================================================
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"
GEMINI_MODEL=gemini-2.0-flash
